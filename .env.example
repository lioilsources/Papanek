# Kopíruj do .env a doplň. Soubor .env se necommituje.
SPARK_HOST=spark.example.lan
# Postgres běží na JODĚ (make db); JODA_HOST je adresa, na které na něj dosáhne Mac.
# JODA_HOST=joda
# Heslo databáze, stejné pro oba profily; prázdné = papanek (jen LAN, žádná osobní data).
# POSTGRES_PASSWORD=

# Skok na L40S pro tools/l40s/sync_photos.sh (stroj, který má v ssh configu host tcloud); prázdné = přímo
L40S_HOP=
